<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xiaohua.mapper.LevelMapper">

    <resultMap id="BaseResultMap" type="com.xiaohua.model.entity.Level">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="levelName" column="levelName" jdbcType="VARCHAR"/>
            <result property="levelDesc" column="levelDesc" jdbcType="VARCHAR"/>
            <result property="options" column="options" jdbcType="VARCHAR"/>
            <result property="difficulty" column="difficulty" jdbcType="VARCHAR"/>
            <result property="targetSalary" column="targetSalary" jdbcType="INTEGER"/>
            <result property="direction" column="direction" jdbcType="VARCHAR"/>
            <result property="priority" column="priority" jdbcType="INTEGER"/>
            <result property="source" column="source" jdbcType="VARCHAR"/>
            <result property="standardAnswer" column="standardAnswer" jdbcType="VARCHAR"/>
            <result property="createTime" column="createTime" jdbcType="TIMESTAMP"/>
            <result property="updateTime" column="updateTime" jdbcType="TIMESTAMP"/>
            <result property="isDelete" column="isDelete" jdbcType="TINYINT"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,levelName,levelDesc,
        options,difficulty,targetSalary,
        direction,priority,createTime,
        updateTime,isDelete
    </sql>

    <resultMap id="HotLevelResultMap" type="com.xiaohua.model.vo.HotLevelVO">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="levelName" column="levelName" jdbcType="VARCHAR"/>
        <result property="levelDesc" column="levelDesc" jdbcType="VARCHAR"/>
        <result property="difficulty" column="difficulty" jdbcType="VARCHAR"/>
        <result property="targetSalary" column="targetSalary" jdbcType="INTEGER"/>
        <result property="direction" column="direction" jdbcType="VARCHAR"/>
        <result property="priority" column="priority" jdbcType="INTEGER"/>
        <result property="playCount" column="playCount" jdbcType="INTEGER"/>
    </resultMap>

    <select id="selectHotLevels" resultMap="HotLevelResultMap">
        SELECT l.id, l.levelName, l.levelDesc, l.difficulty, l.targetSalary,
               l.direction, l.priority,
               (SELECT COUNT(*) FROM user_level ul
                 WHERE ul.levelId = l.id AND ul.isDelete = 0) AS playCount
        FROM level l
        WHERE l.isDelete = 0
        <if test="direction != null and direction != ''">
            AND l.direction = #{direction}
        </if>
        ORDER BY playCount DESC, l.priority DESC, l.id DESC
        LIMIT #{limit}
    </select>

    <!-- 按方向随机取预设题：优先 PRESET，排除用户已答过的，查不到返回 null -->
    <select id="selectRandomByDirection" resultMap="BaseResultMap">
        SELECT *
        FROM level
        WHERE isDelete = 0
          AND direction = #{direction}
          AND id NOT IN (SELECT levelId FROM user_level WHERE userId = #{userId} AND isDelete = 0)
        ORDER BY (source = 'PRESET') DESC, RAND()
        LIMIT 1
    </select>
</mapper>
